# OpenAI Proxy Configuration
# Copy this file to .env and customize as needed

# ===========================
# Port Configuration
# ===========================
# Port for the HAProxy frontend
PROXY_PORT=2020

# Port for Whisper transcription service (internal)
WHISPER_PORT=8000

# Port for Ollama LLM service (internal)
OLLAMA_PORT=11434

# Port for TTS service (internal)
TTS_PORT=8880

# ===========================
# Whisper Configuration
# ===========================
# Whisper model to use
# Options: Systran/faster-whisper-tiny, Systran/faster-whisper-base, 
#          Systran/faster-whisper-small, Systran/faster-whisper-medium,
#          Systran/faster-whisper-large-v2, Systran/faster-whisper-large-v3
WHISPER_MODEL=Systran/faster-whisper-large-v3

# ===========================
# OpenAI API Key
# ===========================
# Required for testing endpoints and for fallback to OpenAI services
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ===========================
# Client Configuration
# ===========================
# Set this in your client applications to use the proxy
# OPENAI_BASE_URL=http://localhost:2020/v1
# OPENAI_API_BASE=http://localhost:2020/v1
